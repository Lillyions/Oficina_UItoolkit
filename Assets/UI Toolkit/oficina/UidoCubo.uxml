<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/oficina/oficinaUI.uss?fileID=7433441132597879392&amp;guid=da9d891cc3217aa4dae7a8ac327ed9cb&amp;type=3#oficinaUI" />
    <ui:VisualElement name="main_container" style="flex-grow: 1; flex-direction: column-reverse;">
        <ui:VisualElement name="buttons_container" style="flex-basis: 30%; flex-direction: row; align-items: center; justify-content: space-between; align-self: auto; padding-right: 10%; padding-left: 10%; background-color: rgba(58, 106, 122, 0.43); border-top-width: 5px; border-left-color: rgba(0, 0, 0, 0.49); border-right-color: rgba(0, 0, 0, 0.49); border-top-color: rgba(0, 0, 0, 0.49); border-bottom-color: rgba(0, 0, 0, 0.49);">
            <ui:Button text="PLAY" parse-escape-sequences="true" display-tooltip-when-elided="true" name="play_button" class="button" style="min-width: 300px; min-height: 80px;" />
            <ui:Button text="STOP" parse-escape-sequences="true" display-tooltip-when-elided="true" name="stop_button" class="button" style="min-width: 300px; min-height: 80px;" />
            <ui:Button text="COLOR" parse-escape-sequences="true" display-tooltip-when-elided="true" name="color_button" class="button" style="min-width: 300px; min-height: 80px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
